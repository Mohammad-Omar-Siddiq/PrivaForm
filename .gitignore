# Python compiler cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.env

# Build and packaging
dist/
build/
*.spec
*.egg-info/
PrivaForm.exe

# User document formats (prevent committing local tests/outputs)
*.tiff
*.tif
*.pdf
*.jpg
*.jpeg
*.png
# Exceptions: keep project icon and test fixtures
!/icon.png
!/tests/fixtures/
!/tests/fixtures/*.tiff
!/tests/fixtures/*.png
!/tests/fixtures/*.jpg

# NCERT Test Files
kebo*.pdf
Merged_NCERT.pdf

# Test caches and artifacts
.pytest_cache/
tests/.pytest_cache/

# Code signing files
privaform.key
privaform.crt
privaform.pfx

# Temporary scratch space
scratch/

# Local AI notes
context.md
